# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# Never commit the real .env file.

# --- Google Sign-In ---
# From https://console.cloud.google.com/apis/credentials
# Create "OAuth client ID" -> Application type "Web application"
# Authorized redirect URI: http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gmail SMTP (used to send the Contact/Feedback form to resumeassistant7@gmail.com) ---
# EMAIL_HOST_USER is the Gmail account that SENDS the mail (can be resumeassistant7@gmail.com itself).
# EMAIL_HOST_PASSWORD must be a 16-character Gmail "App Password" (see README), NOT your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
